# Rust / Cargo build output
/target
/src-tauri/target

# Build logs & scratch from the agent sandbox
*.log
build_msvc*.bat
_scratch_trash/

# Reference / legacy variants (not part of the shippable app)
legacy-wry/

# Node (runtime-host commits only metadata: .npmrc + package.json; the offline
# bundle node.exe + node_modules is regenerated via INSTALL.md, not committed)
/node_modules
runtime-host/node.exe
runtime-host/node_modules/
runtime-host/tools/
runtime-host/.pnpm/
runtime-host/.npm-cache/

# npm cache
.npm-cache/

# Tauri codegen output (regenerated by tauri-build on every compile)
/src-tauri/gen/

# runtime-host metadata is mutated at runtime by the in-app updater
# (npm install rewrites package.json / package-lock.json), so tracking it
# would keep the worktree permanently dirty. tools/prepare-runtime-host.ps1
# regenerates a minimal package.json when it is missing.
runtime-host/package.json
runtime-host/package-lock.json

# Editor cruft
.vscode/
.idea/
